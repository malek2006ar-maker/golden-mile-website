# ====== البيئة ======
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====== قاعدة البيانات (SQLite) ======
# للـ Development المحلي
DATABASE_URL="file:./dev.db"

# للإنتاج على Hostinger
# DATABASE_URL="file:/var/www/html/admin/prisma/production.db"

# ====== المصادقة ======
# ⚠️ غيّر هذا لقيمة عشوائية طويلة (32 حرف على الأقل)
JWT_SECRET="change-this-to-a-very-long-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# ====== بيانات الأدمن الافتراضي ======
ADMIN_EMAIL="admin@goldenmile.com.sa"
ADMIN_PASSWORD="Admin@2026"
ADMIN_NAME="أحمد العتيبي"

# ====== إعدادات إضافية ======
PUBLIC_SITE_URL="https://goldmil.matrxe.com"
WEBHOOK_SECRET="optional-secret-for-incoming-webhooks"